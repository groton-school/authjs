{
  "name": "@groton/authjs-firestore-adapter",
  "version": "1.1.0",
  "homepage": "https://github.com/groton-school/authjs/tree/main/packages/firestore-adapter#readme",
  "repository": {
    "type": "github",
    "url": "https://github.com/groton-school/authjs.git",
    "directory": "packages/firestore-adapter"
  },
  "author": {
    "name": "Seth Battis",
    "email": "sbattis@groton.org"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./collections/*": {
      "types": "./dist/Collections/*.d.ts",
      "default": "./dist/Collections/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "run-s build:*",
    "build:clean": "del ./dist",
    "build:compile": "tsc",
    "prepack": "run-s build",
    "release": "commit-and-tag-version --noBumpWhenEmptyChanges"
  },
  "dependencies": {
    "@battis/lazy-firestore": "catalog:prod"
  },
  "devDependencies": {
    "@battis/workspace": "catalog:dev",
    "@tsconfig/node-lts": "catalog:dev",
    "@types/node": "catalog:dev",
    "del-cli": "catalog:dev",
    "npm-run-all": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "@auth/core": "catalog:prod",
    "@google-cloud/firestore": "*"
  }
}
